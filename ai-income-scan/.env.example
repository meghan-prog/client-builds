# Supabase (optioneel voor lokale dev — zonder deze vars werkt de scan gewoon,
# maar wordt er niets opgeslagen en toont /admin geen data)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (Basic Auth voor /admin)
ADMIN_USER=admin
ADMIN_PASSWORD=

# AI Income Academy CTA doel-URL
NEXT_PUBLIC_ACADEMY_URL=https://example.com/ai-income-academy

# Zet op "true" om de lead-capture stap (naam + e-mail) vóór het resultaat te tonen
NEXT_PUBLIC_LEAD_CAPTURE_ENABLED=true

# Optioneel: GA4 / Meta Pixel IDs (later te koppelen)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
